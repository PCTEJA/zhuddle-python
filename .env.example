# Server-only. Never use a PUBLIC_ or VITE_ prefix for this key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional, public site token from Cloudflare Web Analytics (not an API key).
# Set in the hosting Production build environment and redeploy to enable.
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
